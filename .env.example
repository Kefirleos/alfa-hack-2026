# LLM
LLM_API_KEY=
LLM_BASE_URL=https://changellenge.up.railway.app/v1

# Модели по задачам (их можно менять без правки кода)
LLM_MODEL_FAST=google/gemma-4-26b-a4b-it
LLM_MODEL_WRITER=qwen/qwen3.6-35b-a3b
LLM_MODEL_CRITIC=z-ai/glm-5.3-flash
LLM_MODEL_RESEARCH=deepseek/deepseek-v4.1-flash
LLM_MODEL_FALLBACK=moonshotai/kimi-k2.6
LLM_MODEL_VISION=qwen/qwen3-vl-30b-a3b-instruct

# Бюджет и кэш
LLM_DAILY_BUDGET_RUB=500
LLM_CACHE_DIR=./llm_cache

# Приложение
APP_ENV=development
DATABASE_URL=sqlite:///./app.db
DATA_DIR=./data/synthetic